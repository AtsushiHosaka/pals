# Safe defaults for the single local Docker dependency.
# Copy to .env.local for personal overrides. Do not commit .env.local.

PALS_HOST_BIND_ADDRESS=127.0.0.1
POSTGRES_DB=pals
POSTGRES_USER=pals
POSTGRES_PASSWORD=pals
POSTGRES_HOST_PORT=55432

# Host-side application processes can use this URL.
PALS_DATABASE_URL=postgresql+psycopg://pals:pals@127.0.0.1:55432/pals

# Optional host-side LLM settings.
PALS_LLM_PROVIDER=ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_PROVE_MODEL=qwen2.5:3b
OPENAI_API_KEY=
