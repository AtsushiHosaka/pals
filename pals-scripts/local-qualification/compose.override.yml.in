services:
  postgres:
    profiles: [unused-external-db]
  localstack:
    labels: {codex.owner: "01a1bb4b-dec2-76f0-a6fe-32405e465d6e", codex.expiry: "2026-11-09T15:00:00Z"}
    environment:
      PALS_LOCAL_DATABASE_HOST: postgres
      PALS_LOCAL_DATABASE_NAME: pals
      PALS_LOCAL_DATABASE_USERNAME: ${POSTGRES_USER}
      PALS_LOCAL_DATABASE_PASSWORD: ${POSTGRES_PASSWORD}
  cognito-local:
    labels: {codex.owner: "01a1bb4b-dec2-76f0-a6fe-32405e465d6e", codex.expiry: "2026-11-09T15:00:00Z"}
  schema-release:
    image: @@API_IMAGE@@
  api:
    image: @@API_IMAGE@@
    volumes: !override []
    depends_on: !override {localstack: {condition: service_healthy}, cognito-local: {condition: service_healthy}, reconciler: {condition: service_healthy}}
    labels: {codex.owner: "01a1bb4b-dec2-76f0-a6fe-32405e465d6e", codex.expiry: "2026-11-09T15:00:00Z"}
    environment:
      PALS_GUEST_CHAT_ENABLED: "true"
      PALS_BILLING_CONFIG_JSON: ""
      PALS_GUEST_HASH_KEY: ${PALS_GUEST_HASH_KEY}
      PALS_GUEST_ALLOWED_ORIGINS: ${PALS_GUEST_ALLOWED_ORIGINS}
      PALS_CLOUD_RESTORE_MANIFEST_SHA256: ${PALS_LOCAL_CANDIDATE_SHA256}
  reconciler:
    image: @@API_IMAGE@@
    depends_on: !override {localstack: {condition: service_healthy}, verifier: {condition: service_healthy}}
    labels: {codex.owner: "01a1bb4b-dec2-76f0-a6fe-32405e465d6e", codex.expiry: "2026-11-09T15:00:00Z"}
  verifier:
    image: @@VERIFIER_IMAGE@@
    platform: linux/arm64
    labels: {codex.owner: "01a1bb4b-dec2-76f0-a6fe-32405e465d6e", codex.expiry: "2026-11-09T15:00:00Z"}
  worker-network-guard:
    extra_hosts: ["api.openai.com:127.0.0.1"]
    image: @@GUARD_IMAGE@@
    pull_policy: never
    platform: linux/amd64
    user: "0:0"
    read_only: true
    cap_drop: [ALL]
    cap_add: [NET_ADMIN, NET_BIND_SERVICE]
    security_opt: [no-new-privileges:true]
    labels: {codex.owner: "01a1bb4b-dec2-76f0-a6fe-32405e465d6e", codex.expiry: "2026-11-09T15:00:00Z"}
    environment:
      OPENAI_API_KEY: ${OPENAI_API_KEY}
      PALS_OPENAI_UPSTREAM_IP: ${PALS_OPENAI_UPSTREAM_IP}
      PALS_BUDGET_RESUME_SHA256: ${PALS_BUDGET_RESUME_SHA256:-}
    tmpfs: ["/run/guard:rw,noexec,nosuid,size=1m"]
    volumes:
      - @@RUNTIME@@/provider-tls:/run/provider:ro
      - @@RUNTIME@@/budget:/run/budget:rw
    healthcheck:
      test: [CMD, python, -c, "import socket; socket.create_connection(('127.0.0.1',443),2).close()"]
      interval: 2s
      timeout: 3s
      retries: 10
    networks:
      e2e:
        ipv4_address: 172.30.0.30
        aliases: [pals-recipe-reviewer]
  worker:
    user: "65532:65532"
    entrypoint: !override []
    networks: !reset null
    network_mode: service:worker-network-guard
    cap_add: !reset []
    cap_drop: !override [ALL]
    volumes:
      - @@RUNTIME@@/provider-tls/ca-bundle.pem:/run/local-provider-ca.pem:ro
    depends_on: !override {api: {condition: service_healthy}, worker-network-guard: {condition: service_healthy}}
    environment:
      SSL_CERT_FILE: /run/local-provider-ca.pem
    healthcheck:
      test: !override [CMD, python, -c, "from pathlib import Path; import os; os.kill(int(Path('/tmp/pals-worker-ready').read_text()),0)"]
    image: @@WORKER_IMAGE@@
    platform: linux/amd64
    labels: {codex.owner: "01a1bb4b-dec2-76f0-a6fe-32405e465d6e", codex.expiry: "2026-11-09T15:00:00Z"}
  assessment-worker:
    user: "65532:65532"
    entrypoint: !override []
    networks: !reset null
    network_mode: service:worker-network-guard
    cap_add: !reset []
    cap_drop: !override [ALL]
    volumes:
      - @@RUNTIME@@/provider-tls/ca-bundle.pem:/run/local-provider-ca.pem:ro
    depends_on: !override {api: {condition: service_healthy}, worker-network-guard: {condition: service_healthy}}
    environment:
      SSL_CERT_FILE: /run/local-provider-ca.pem
    healthcheck:
      test: !override [CMD, python, -c, "from pathlib import Path; import os; os.kill(int(Path('/tmp/pals-worker-ready').read_text()),0)"]
    image: @@WORKER_IMAGE@@
    platform: linux/amd64
    labels: {codex.owner: "01a1bb4b-dec2-76f0-a6fe-32405e465d6e", codex.expiry: "2026-11-09T15:00:00Z"}
  recipe-reviewer:
    user: "65532:65532"
    entrypoint: !override []
    networks: !reset null
    network_mode: service:worker-network-guard
    cap_add: !reset []
    cap_drop: !override [ALL]
    volumes:
      - @@RUNTIME@@/provider-tls/ca-bundle.pem:/run/local-provider-ca.pem:ro
    depends_on: !override {api: {condition: service_healthy}, worker-network-guard: {condition: service_healthy}}
    environment:
      SSL_CERT_FILE: /run/local-provider-ca.pem
    image: @@WORKER_IMAGE@@
    platform: linux/amd64
    labels: {codex.owner: "01a1bb4b-dec2-76f0-a6fe-32405e465d6e", codex.expiry: "2026-11-09T15:00:00Z"}
  webfront:
    image: @@WEB_IMAGE@@
    labels: {codex.owner: "01a1bb4b-dec2-76f0-a6fe-32405e465d6e", codex.expiry: "2026-11-09T15:00:00Z"}
networks:
  e2e:
    name: pals-reliability-local-e2e
  database:
    name: pals-reliability-local-database
