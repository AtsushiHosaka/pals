# Copy this file to .env.local, .env.dev, or .env.prod.
# Never commit .env.local, .env.dev, or .env.prod.

PALS_ENV=dev
# Leave AWS_PROFILE blank to use pals-local, pals-dev, or pals-prod from --env.
AWS_PROFILE=
AWS_REGION=ap-northeast-1

# Optional identifiers used by scripts.
PALS_API_BASE_URL=https://api.example.invalid
PALS_AURORA_SECRET_ID=/pals/dev/aurora
PALS_AURORA_DATABASE=pals
PALS_CLOUDWATCH_LOG_GROUP_API=/aws/lambda/pals-dev-api
PALS_CLOUDWATCH_LOG_GROUP_AGENT=/aws/ecs/pals-dev-agent

# LocalStack defaults for .local development. These are dummy credentials and
# local endpoints only.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=ap-northeast-1
PALS_AWS_ENDPOINT_URL=http://localhost:4567
PALS_HOST_AWS_ENDPOINT_URL=http://localhost:4567
PALS_ARTIFACTS_BUCKET=pals-local-artifacts
PALS_PROOF_JOBS_QUEUE_NAME=pals-local-proof-jobs
PALS_PROOF_JOBS_DLQ_NAME=pals-local-proof-jobs-dlq
PALS_PROOF_JOBS_QUEUE_URL=http://sqs.ap-northeast-1.localhost.localstack.cloud:4567/000000000000/pals-local-proof-jobs
PALS_HOST_PROOF_JOBS_QUEUE_URL=http://localhost:4567/000000000000/pals-local-proof-jobs
# The authenticated explanation smoke launches the production Compose worker
# and isolated verifier with this root-level, ignored environment file.
PALS_COMPOSE_ENV_FILE=.env.local

# Langfuse public host is safe. Secret keys are local only.
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=replace-with-local-public-key
LANGFUSE_SECRET_KEY=replace-with-local-secret-key

# Local LLM settings. Leave PALS_LLM_PROVIDER blank to use the script default:
# local -> ollama, dev/prod -> bedrock.
# Example .env.local overrides:
# PALS_ENV=local
# PALS_LLM_PROVIDER=ollama
# PALS_LOCAL_TRAINING_BACKEND=mlx
# PALS_LOCAL_HARDWARE=M5_MAX_128GB
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_DRAFT_MODEL=qwen2.5:3b
# OLLAMA_PROVE_MODEL=qwen2.5:3b
# OpenAI override:
# PALS_LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# PALS_OPENAI_MODEL=gpt-5.4-nano
# PALS_OPENAI_BASE_URL=https://api.openai.com/v1
# PALS_OPENAI_MAX_OUTPUT_TOKENS=6000
PALS_LLM_PROVIDER=
PALS_LOCAL_TRAINING_BACKEND=mlx
PALS_LOCAL_HARDWARE=M5_MAX_128GB
POSTGRES_DB=pals
POSTGRES_USER=pals
POSTGRES_PASSWORD=pals
POSTGRES_HOST_PORT=55432
PALS_DATABASE_URL=postgresql+psycopg://pals:pals@postgres:5432/pals
PALS_AGENT_DATABASE_URL=postgresql://pals:pals@postgres:5432/pals
PALS_HOST_DATABASE_URL=postgresql://pals:pals@localhost:55432/pals
PALS_DATABASE_SECRET_ID=/pals/local/postgres
PALS_DRAFT_EMBEDDING_PROVIDER=openai
PALS_DRAFT_EMBEDDING_MODEL=text-embedding-3-small
PALS_DRAFT_EMBEDDING_DIM=384
PALS_DRAFT_EMBEDDING_TIMEOUT_SECONDS=60
PALS_DRAFT_RETRIEVAL_MIN_SIMILARITY=0.35
PALS_DRAFT_RETRIEVAL_TOP_K=40
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_DRAFT_MODEL=qwen2.5:3b
OLLAMA_PROVE_MODEL=qwen2.5:3b
OPENAI_API_KEY=
PALS_OPENAI_MODEL=gpt-5.4-nano
PALS_OPENAI_BASE_URL=https://api.openai.com/v1
PALS_OPENAI_MAX_OUTPUT_TOKENS=6000
