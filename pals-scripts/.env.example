# Copy this file to .env.dev or .env.prod.
# Never commit .env.dev or .env.prod.

PALS_ENV=dev
AWS_PROFILE=pals-dev
AWS_REGION=us-east-1

# Optional identifiers used by scripts.
PALS_API_BASE_URL=https://api.example.invalid
PALS_AURORA_SECRET_ID=/pals/dev/aurora
PALS_AURORA_DATABASE=pals
PALS_CLOUDWATCH_LOG_GROUP_API=/aws/lambda/pals-dev-api
PALS_CLOUDWATCH_LOG_GROUP_AGENT=/aws/ecs/pals-dev-agent

# Langfuse public host is safe. Secret keys are local only.
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=replace-with-local-public-key
LANGFUSE_SECRET_KEY=replace-with-local-secret-key
