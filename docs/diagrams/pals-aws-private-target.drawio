        <mxCell id="e_alb_control" value="APIは既定経路 / rootは優先順位10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#3a8760;strokeWidth=2;dashed=0;fontSize=16;fontFamily=Hiragino Sans,Noto Sans JP,Arial;fontColor=#3a8760;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="alb" target="control_c">
          <mxGeometry relative="1" as="geometry">
            <Array>
              <mxPoint x="1250" y="675" />
              <mxPoint x="1250" y="780" />
            </Array>
