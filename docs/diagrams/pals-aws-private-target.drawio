<mxfile host="app.diagrams.net" agent="PALS architecture authoring" version="32.6.1">
  <diagram id="pals-private-target" name="AWS migration — actual state 2026-10-31">
    <mxGraphModel dx="2240" dy="2120" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2240" pageHeight="2120" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="header" value="&lt;b&gt;PALS AWS移行　実際の配備状況と切替後の通信&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#142d4e;strokeColor=#142d4e;strokeWidth=1.5;fontSize=30;fontColor=#18314e;fontFamily=Hiragino Sans,Noto Sans JP,Arial;align=left;verticalAlign=middle;spacing=12;fontColor=#ffffff;spacingLeft=24;" vertex="1" parent="1">
          <mxGeometry x="40" y="25" width="2160" height="65" as="geometry" />
        </mxCell>
        <mxCell id="status" value="&lt;b&gt;Web・API・Lean回答はAWSで稼働　2026年10月31日 19:14 JST時点&lt;/b&gt;&lt;br&gt;公開ブラウザで自然数冪の連続性の回答とLeanコードを確認。新リリースの検証記録・attestationも保存済み。&lt;br&gt;実回答まで154.33秒、最終Lean検証3.499秒。1秒目標は未達。追加20問はAWS実コンパイル・DB登録済み。独立レビュー・検索登録は継続中。" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff1db;strokeColor=#dba54d;strokeWidth=1.5;fontSize=20;fontColor=#18314e;fontFamily=Hiragino Sans,Noto Sans JP,Arial;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="105" width="2160" height="100" as="geometry" />
        </mxCell>
        <mxCell id="region" value="&lt;b&gt;AWS 東京リージョン　ap-northeast-1　｜　account 828786775577&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f5f8fc;strokeColor=#8ca4c0;strokeWidth=1.5;fontSize=21;fontColor=#18314e;fontFamily=Hiragino Sans,Noto Sans JP,Arial;align=left;verticalAlign=middle;spacing=12;verticalAlign=top;spacingTop=12;spacingLeft=16;absoluteArcSize=1;arcSize=16;" vertex="1" parent="1">
