        <mxCell id="cloudflare" value="&lt;b&gt;Cloudflare DNS / Proxy&lt;/b&gt;&lt;br&gt;palschat.site → AWS ALBへ切替済み&lt;br&gt;api.palschat.site → Mini Tunnelを継続&lt;br&gt;proxied / Full (strict)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf7ee;strokeColor=#579a72;strokeWidth=1.5;fontSize=19;fontColor=#18314e;fontFamily=Hiragino Sans,Noto Sans JP,Arial;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="310" y="235" width="385" height="120" as="geometry" />
        </mxCell>
        <mxCell id="mini" value="&lt;b&gt;Mac mini　API・Leanの本番&lt;/b&gt;&lt;br&gt;回答生成・Lean処理・現行DB&lt;br&gt;APIの既存Tunnel経路を継続" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf7ee;strokeColor=#579a72;strokeWidth=1.5;fontSize=19;fontColor=#18314e;fontFamily=Hiragino Sans,Noto Sans JP,Arial;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="800" y="245" width="330" height="100" as="geometry" />
        </mxCell>
        <mxCell id="operator" value="&lt;b&gt;運用者&lt;/b&gt;&lt;br&gt;AWS SSO → SSM&lt;br&gt;SSHポート・踏み台なし" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f3eefb;strokeColor=#aa95c4;strokeWidth=1.5;fontSize=19;fontColor=#18314e;fontFamily=Hiragino Sans,Noto Sans JP,Arial;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1240" y="245" width="360" height="100" as="geometry" />
        </mxCell>
        <mxCell id="llm" value="&lt;b&gt;外部LLM API&lt;/b&gt;&lt;br&gt;現在はMac mini workerからHTTPS 443&lt;br&gt;AWS workerは未起動" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff5e9;strokeColor=#d3aa73;strokeWidth=1.5;fontSize=19;fontColor=#18314e;fontFamily=Hiragino Sans,Noto Sans JP,Arial;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1720" y="245" width="440" height="100" as="geometry" />
        </mxCell>
        <mxCell id="waf" value="&lt;b&gt;ALBのWAF設定　適用済み&lt;/b&gt;&lt;br&gt;Cloudflare公式IPv4 15範囲のみ許可" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf7ee;strokeColor=#579a72;strokeWidth=1.5;fontSize=18;fontColor=#18314e;fontFamily=Hiragino Sans,Noto Sans JP,Arial;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="620" y="555" width="520" height="65" as="geometry" />
        </mxCell>
        <mxCell id="alb" value="&lt;b&gt;Internet-facing ALB　HTTPS 443 / ACM&lt;/b&gt;&lt;br&gt;root Host rule priority 10 → Web target group" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf7ee;strokeColor=#579a72;strokeWidth=1.5;fontSize=19;fontColor=#18314e;fontFamily=Hiragino Sans,Noto Sans JP,Arial;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="620" y="640" width="520" height="70" as="geometry" />
        </mxCell>
        <mxCell id="nat" value="&lt;b&gt;NAT Gateway ×1　AZ 1a&lt;/b&gt;&lt;br&gt;host外向き / Web containerはDROP" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff5e9;strokeColor=#d3aa73;strokeWidth=1.5;fontSize=18;fontColor=#18314e;fontFamily=Hiragino Sans,Noto Sans JP,Arial;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="130" y="615" width="330" height="75" as="geometry" />
        </mxCell>
        <mxCell id="igw" value="&lt;b&gt;Internet Gateway&lt;/b&gt;&lt;br&gt;公開入口とNATの経路" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eef5fe;strokeColor=#8db1d9;strokeWidth=1.5;fontSize=18;fontColor=#18314e;fontFamily=Hiragino Sans,Noto Sans JP,Arial;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1290" y="615" width="290" height="75" as="geometry" />
        </mxCell>
        <mxCell id="control" value="&lt;b&gt;Control EC2　t4g.medium　Webのみ公開中&lt;/b&gt;&lt;br&gt;2 vCPU / 4 GiB・ARM64　10.42.20.43 / public IPv4なし&lt;br&gt;Web: pals-web-bootstrap-20261031&lt;br&gt;bridge 172.29.43.0/24 ・ container .30&lt;br&gt;UID1000 / cap0 / read-only / 専用outbound DROP&lt;br&gt;AWS API・Caddy・reconcilerは未起動" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf7ee;strokeColor=#579a72;strokeWidth=1.5;fontSize=19;fontColor=#18314e;fontFamily=Hiragino Sans,Noto Sans JP,Arial;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="130" y="800" width="670" height="175" as="geometry" />
        </mxCell>
        <mxCell id="control_c" value="&lt;b&gt;Web target group　healthy確認済み&lt;/b&gt;&lt;br&gt;HTTP 8080 / health path「/」&lt;br&gt;target: private control 10.42.20.43:8080&lt;br&gt;ALB SG → control SG の8080だけ許可&lt;br&gt;Caddy経由の将来構成は未起動。1cはsubnetのみ。" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf7ee;strokeColor=#579a72;strokeWidth=1.5;fontSize=19;fontColor=#18314e;fontFamily=Hiragino Sans,Noto Sans JP,Arial;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="920" y="800" width="660" height="175" as="geometry" />
        </mxCell>
        <mxCell id="compute" value="&lt;b&gt;Compute EC2　r8a.large　稼働中&lt;/b&gt;&lt;br&gt;2 vCPU / 16 GiB・AMD64　10.42.30.100&lt;br&gt;評価・証明worker / reviewer / 隔離Lean verifierは起動前&lt;br&gt;verifierへDB・AWS・LLMの資格情報を渡さない" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff5df;strokeColor=#c3a15a;strokeWidth=1.5;fontSize=18;fontColor=#18314e;fontFamily=Hiragino Sans,Noto Sans JP,Arial;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="130" y="1110" width="670" height="125" as="geometry" />
        </mxCell>
        <mxCell id="capacity" value="&lt;b&gt;Compute 1c　subnetのみ&lt;/b&gt;&lt;br&gt;大会時xlargeへの切替・実行枠増設は今後の作業。&lt;br&gt;ASG・自動増減・30件の同時負荷検証は未配備。&lt;br&gt;1秒回答・30件を10秒以内の性能は未達成・未確認。" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#bdc8d4;strokeWidth=1.5;fontSize=18;fontColor=#18314e;fontFamily=Hiragino Sans,Noto Sans JP,Arial;align=left;verticalAlign=middle;spacing=12;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="920" y="1110" width="660" height="125" as="geometry" />
        </mxCell>
        <mxCell id="database" value="&lt;b&gt;DB EC2　m7g.large　サーバー起動確認済み&lt;/b&gt;&lt;br&gt;2 vCPU / 8 GiB・ARM64　10.42.10.172&lt;br&gt;PostgreSQL 16.15 / pgvector 0.8.7 / glibc 2.36&lt;br&gt;TLS 1.3確認済み。空DB・未復元・受入検証前。&lt;br&gt;専用SG sg-0ff215b067897c752　controlから5432のみ&lt;br&gt;専用・保持対象EBS 80 GiB gp3 / 暗号化&lt;br&gt;vol-007fcbf9fa67f80fd　→　/srv/pals-postgresql" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf7ee;strokeColor=#579a72;strokeWidth=1.5;fontSize=18;fontColor=#18314e;fontFamily=Hiragino Sans,Noto Sans JP,Arial;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="130" y="1370" width="670" height="205" as="geometry" />
        </mxCell>
        <mxCell id="db_endpoints" value="&lt;b&gt;DB専用のprivate通信&lt;/b&gt;&lt;br&gt;DB-Aにinterface endpoint ×6&lt;br&gt;SSM / ssmmessages / ECR api / ECR dkr / logs / monitoring&lt;br&gt;private DNS=false。DBホストだけの/etc/hostsで解決。&lt;br&gt;VPC全体のDNS設定は上書きしない。&lt;br&gt;DB専用S3 Gateway Endpoint・対象bucketを限定。&lt;br&gt;NAT・IGW向け経路なし。DB 1cは予約subnet。" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f2edfb;strokeColor=#a995c9;strokeWidth=1.5;fontSize=18;fontColor=#18314e;fontFamily=Hiragino Sans,Noto Sans JP,Arial;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="920" y="1370" width="660" height="205" as="geometry" />
        </mxCell>
        <mxCell id="isolation" value="&lt;b&gt;private境界&lt;/b&gt;&lt;br&gt;全EC2はpublic IPv4なし・IMDSv2必須・SSM管理。computeからDBへの経路は許可しない。&lt;br&gt;postgresql.pals.internalは署名対象IPへのhost map。DBのprivate hosted zoneは作成していない。" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eef3f9;strokeColor=#b2c3d6;strokeWidth=1.5;fontSize=19;fontColor=#18314e;fontFamily=Hiragino Sans,Noto Sans JP,Arial;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="1645" width="1520" height="90" as="geometry" />
        </mxCell>
        <mxCell id="cognito" value="&lt;b&gt;Cognito　既存設定を維持&lt;/b&gt;&lt;br&gt;ブラウザーから利用者認証&lt;br&gt;現在のAPI接続先はMac mini" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a6b9ce;strokeWidth=1.5;fontSize=19;fontColor=#18314e;fontFamily=Hiragino Sans,Noto Sans JP,Arial;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1720" y="490" width="440" height="100" as="geometry" />
        </mxCell>
        <mxCell id="queues" value="&lt;b&gt;SQS + DLQ　既存を利用&lt;/b&gt;&lt;br&gt;現在はMac mini workerが利用&lt;br&gt;AWSの評価・証明workerは未起動&lt;br&gt;AWS側はHTTPS 443 / NAT経由を予定" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a6b9ce;strokeWidth=1.5;fontSize=19;fontColor=#18314e;fontFamily=Hiragino Sans,Noto Sans JP,Arial;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1720" y="620" width="440" height="120" as="geometry" />
        </mxCell>
        <mxCell id="storage" value="&lt;b&gt;S3 / Gateway Endpoint&lt;/b&gt;&lt;br&gt;資料・成果物・暗号化バックアップ&lt;br&gt;control / compute用gatewayと&lt;br&gt;DB専用gatewayを分離&lt;br&gt;S3はNATを通らない" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#edf7f3;strokeColor=#8bbba7;strokeWidth=1.5;fontSize=19;fontColor=#18314e;fontFamily=Hiragino Sans,Noto Sans JP,Arial;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1720" y="770" width="440" height="150" as="geometry" />
        </mxCell>
        <mxCell id="aws_apis" value="&lt;b&gt;SSM / ECR / CloudWatch&lt;/b&gt;&lt;br&gt;control・computeはNAT経由HTTPS&lt;br&gt;DBは専用interface endpoint経由&lt;br&gt;SSM SecureString / KMSで秘密値管理" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a6b9ce;strokeWidth=1.5;fontSize=19;fontColor=#18314e;fontFamily=Hiragino Sans,Noto Sans JP,Arial;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1720" y="950" width="440" height="130" as="geometry" />
        </mxCell>
        <mxCell id="aurora_retained" value="&lt;b&gt;Aurora　未採用・保持中&lt;/b&gt;&lt;br&gt;本番予約用と互換性検証用が残存&lt;br&gt;本番DBはEC2方式へ変更&lt;br&gt;Auroraへ本番接続していない" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b8b8b8;strokeWidth=1.5;fontSize=18;fontColor=#18314e;fontFamily=Hiragino Sans,Noto Sans JP,Arial;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1720" y="1110" width="440" height="125" as="geometry" />
        </mxCell>
        <mxCell id="ops" value="&lt;b&gt;Web切替済み・backend移行待ち&lt;/b&gt;&lt;br&gt;署名付きrelease / admissionでDBを検証&lt;br&gt;AWS API・worker・verifierを実機確認&lt;br&gt;APIドメインの切替はその後に実施&lt;br&gt;Web公開と全体移行の完了を区別" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f3eefb;strokeColor=#aa95c4;strokeWidth=1.5;fontSize=18;fontColor=#18314e;fontFamily=Hiragino Sans,Noto Sans JP,Arial;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1720" y="1270" width="440" height="135" as="geometry" />
        </mxCell>
        <mxCell id="waf_notes" value="&lt;b&gt;WAFの実測　11:40 JST&lt;/b&gt;&lt;br&gt;ALB associationをAPIで読み戻し済み&lt;br&gt;default BLOCK / network source IP&lt;br&gt;ForwardedIP設定なし / sample保持なし&lt;br&gt;Cloudflare外からのALB直アクセスは403&lt;br&gt;TLS証明書検証成功&lt;br&gt;公式15範囲はCloudflare全体で共有。&lt;br&gt;個別zone認証の代用にはしない。&lt;br&gt;Host制限・アプリ認証は継続。" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf7ee;strokeColor=#579a72;strokeWidth=1.5;fontSize=18;fontColor=#18314e;fontFamily=Hiragino Sans,Noto Sans JP,Arial;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1720" y="1435" width="440" height="300" as="geometry" />
        </mxCell>
        <mxCell id="e_user" value="HTTPS 443" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#3a8760;strokeWidth=2;dashed=0;fontSize=16;fontFamily=Hiragino Sans,Noto Sans JP,Arial;fontColor=#3a8760;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="user" target="cloudflare">
