        </mxCell>
        <mxCell id="mini" value="&lt;b&gt;旧Mac mini&lt;/b&gt;&lt;br&gt;旧DBを保持／他7コンテナ停止&lt;br&gt;公開DNSはAWSへ切替済み" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf7ee;strokeColor=#579a72;strokeWidth=1.5;fontSize=19;fontColor=#18314e;fontFamily=Hiragino Sans,Noto Sans JP,Arial;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="800" y="245" width="330" height="100" as="geometry" />
        </mxCell>
        <mxCell id="operator" value="&lt;b&gt;運用者&lt;/b&gt;&lt;br&gt;AWS SSO → SSM&lt;br&gt;SSHポート・踏み台なし" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f3eefb;strokeColor=#aa95c4;strokeWidth=1.5;fontSize=19;fontColor=#18314e;fontFamily=Hiragino Sans,Noto Sans JP,Arial;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1240" y="245" width="360" height="100" as="geometry" />
        </mxCell>
        <mxCell id="llm" value="&lt;b&gt;外部LLM API&lt;/b&gt;&lt;br&gt;AWS workerからHTTPS 443で接続&lt;br&gt;評価・証明生成・解説の実処理を確認" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff5e9;strokeColor=#d3aa73;strokeWidth=1.5;fontSize=19;fontColor=#18314e;fontFamily=Hiragino Sans,Noto Sans JP,Arial;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1720" y="245" width="440" height="100" as="geometry" />
        </mxCell>
        <mxCell id="waf" value="&lt;b&gt;ALBのWAF設定　適用済み&lt;/b&gt;&lt;br&gt;Cloudflare公式IPv4 15範囲のみ許可" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf7ee;strokeColor=#579a72;strokeWidth=1.5;fontSize=18;fontColor=#18314e;fontFamily=Hiragino Sans,Noto Sans JP,Arial;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="620" y="555" width="520" height="65" as="geometry" />
        </mxCell>
        <mxCell id="alb" value="&lt;b&gt;Internet-facing ALB　HTTPS 443 / ACM&lt;/b&gt;&lt;br&gt;root優先rule・API既定ruleとも本番target group" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf7ee;strokeColor=#579a72;strokeWidth=1.5;fontSize=19;fontColor=#18314e;fontFamily=Hiragino Sans,Noto Sans JP,Arial;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="620" y="640" width="520" height="70" as="geometry" />
        </mxCell>
        <mxCell id="nat" value="&lt;b&gt;NAT Gateway ×1　AZ 1a&lt;/b&gt;&lt;br&gt;host外向き / Web containerはDROP" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff5e9;strokeColor=#d3aa73;strokeWidth=1.5;fontSize=18;fontColor=#18314e;fontFamily=Hiragino Sans,Noto Sans JP,Arial;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="130" y="615" width="330" height="75" as="geometry" />
        </mxCell>
        <mxCell id="igw" value="&lt;b&gt;Internet Gateway&lt;/b&gt;&lt;br&gt;公開入口とNATの経路" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eef5fe;strokeColor=#8db1d9;strokeWidth=1.5;fontSize=18;fontColor=#18314e;fontFamily=Hiragino Sans,Noto Sans JP,Arial;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1290" y="615" width="290" height="75" as="geometry" />
        </mxCell>
        <mxCell id="control" value="&lt;b&gt;Control EC2　t4g.medium　Web・API公開&lt;/b&gt;&lt;br&gt;2 vCPU / 4 GiB・ARM64　10.42.20.43 / public IPv4なし&lt;br&gt;API・Caddy・Web・reconcilerを実機起動確認&lt;br&gt;bridge 172.30.0.0/24 / API .20 / Caddy .10&lt;br&gt;reconciler .40の実mTLS接続も成功&lt;br&gt;一時Web・172.29.43 bridgeは削除済み" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf7ee;strokeColor=#579a72;strokeWidth=1.5;fontSize=19;fontColor=#18314e;fontFamily=Hiragino Sans,Noto Sans JP,Arial;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="130" y="800" width="670" height="175" as="geometry" />
        </mxCell>
        <mxCell id="control_c" value="&lt;b&gt;本番target group　healthy&lt;/b&gt;&lt;br&gt;HTTPS 443 / health「/health/ready」&lt;br&gt;Web・APIともprivate control EC2のCaddyへ&lt;br&gt;一時HTTP 8080 target groupと専用SGルールは削除" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf7ee;strokeColor=#579a72;strokeWidth=1.5;fontSize=19;fontColor=#18314e;fontFamily=Hiragino Sans,Noto Sans JP,Arial;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="920" y="800" width="660" height="175" as="geometry" />
        </mxCell>
        <mxCell id="compute" value="&lt;b&gt;Compute EC2　r8a.large　修正版runtime稼働&lt;/b&gt;&lt;br&gt;2 vCPU / 16 GiB・AMD64　10.42.30.100&lt;br&gt;評価worker・証明worker・Lean verifierを更新&lt;br&gt;HTTP用scratchで実Leanコンパイル成功&lt;br&gt;TLS隣接ディレクトリへの読取拒否も実検証" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff5df;strokeColor=#c3a15a;strokeWidth=1.5;fontSize=18;fontColor=#18314e;fontFamily=Hiragino Sans,Noto Sans JP,Arial;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="130" y="1110" width="670" height="125" as="geometry" />
        </mxCell>
        <mxCell id="capacity" value="&lt;b&gt;Compute 1c　subnetのみ&lt;/b&gt;&lt;br&gt;大会時xlargeへの切替・実行枠増設は今後の作業。&lt;br&gt;ASG・自動増減・30件の同時負荷検証は未配備。&lt;br&gt;1秒回答・30件を10秒以内の性能は未達成・未確認。" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#bdc8d4;strokeWidth=1.5;fontSize=18;fontColor=#18314e;fontFamily=Hiragino Sans,Noto Sans JP,Arial;align=left;verticalAlign=middle;spacing=12;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="920" y="1110" width="660" height="125" as="geometry" />
        </mxCell>
        <mxCell id="database" value="&lt;b&gt;本番Aurora　初期化成功&lt;/b&gt;&lt;br&gt;pals-prod-aurora／PostgreSQL 16.15／private endpoint&lt;br&gt;33段階のmigration・限定roleの接続検査に成功&lt;br&gt;Draft 433件／検証済みRecipe 20件／検索entry 0件。旧チャット履歴は移送しない。&lt;br&gt;control SGから5432のみ許可、TLS verify-full／暗号化&lt;br&gt;1cはDB subnet。readerによる冗長化は未実施。" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf7ee;strokeColor=#579a72;strokeWidth=1.5;fontSize=18;fontColor=#18314e;fontFamily=Hiragino Sans,Noto Sans JP,Arial;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="130" y="1370" width="670" height="205" as="geometry" />
        </mxCell>
        <mxCell id="db_endpoints" value="&lt;b&gt;旧方式のDB EC2・専用endpoint　未使用&lt;/b&gt;&lt;br&gt;m7g.large／10.42.10.172／停止済み／EBS 80 GiB保持&lt;br&gt;専用interface endpoint ×6は残存&lt;br&gt;SSM / ssmmessages / ECR api・dkr / logs / monitoring&lt;br&gt;DBホスト限定の名前解決。専用S3 endpointも残存。&lt;br&gt;EC2は停止済み。EBS・endpointは保持。Auroraの接続先ではない。" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f2edfb;strokeColor=#a995c9;strokeWidth=1.5;fontSize=18;fontColor=#18314e;fontFamily=Hiragino Sans,Noto Sans JP,Arial;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="920" y="1370" width="660" height="205" as="geometry" />
        </mxCell>
        <mxCell id="isolation" value="&lt;b&gt;private境界&lt;/b&gt;&lt;br&gt;全EC2はpublic IPv4なし・IMDSv2必須・SSM管理。computeからDBへの接続は許可しない。&lt;br&gt;本番AuroraへはcontrolからTLS verify-fullで接続。RDSの公式CAを固定し照合。" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eef3f9;strokeColor=#b2c3d6;strokeWidth=1.5;fontSize=19;fontColor=#18314e;fontFamily=Hiragino Sans,Noto Sans JP,Arial;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="1645" width="1520" height="90" as="geometry" />
        </mxCell>
        <mxCell id="cognito" value="&lt;b&gt;Cognito　既存設定を維持&lt;/b&gt;&lt;br&gt;ブラウザーから利用者認証&lt;br&gt;API接続先はAWSへ切替済み" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a6b9ce;strokeWidth=1.5;fontSize=19;fontColor=#18314e;fontFamily=Hiragino Sans,Noto Sans JP,Arial;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1720" y="490" width="440" height="100" as="geometry" />
        </mxCell>
        <mxCell id="queues" value="&lt;b&gt;SQS + DLQ　既存を利用&lt;/b&gt;&lt;br&gt;AWSの評価・証明workerを起動確認&lt;br&gt;旧workerは停止中&lt;br&gt;AWS側はHTTPS 443 / NAT経由" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a6b9ce;strokeWidth=1.5;fontSize=19;fontColor=#18314e;fontFamily=Hiragino Sans,Noto Sans JP,Arial;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1720" y="620" width="440" height="120" as="geometry" />
        </mxCell>
        <mxCell id="storage" value="&lt;b&gt;S3 / Gateway Endpoint&lt;/b&gt;&lt;br&gt;資料・成果物・暗号化バックアップ&lt;br&gt;control / compute用gatewayと&lt;br&gt;DB専用gatewayを分離&lt;br&gt;S3はNATを通らない" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#edf7f3;strokeColor=#8bbba7;strokeWidth=1.5;fontSize=19;fontColor=#18314e;fontFamily=Hiragino Sans,Noto Sans JP,Arial;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1720" y="770" width="440" height="150" as="geometry" />
        </mxCell>
        <mxCell id="aws_apis" value="&lt;b&gt;SSM / ECR / CloudWatch&lt;/b&gt;&lt;br&gt;control・computeはNAT経由HTTPS&lt;br&gt;DBは専用interface endpoint経由&lt;br&gt;SSM SecureString / KMSで秘密値管理" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a6b9ce;strokeWidth=1.5;fontSize=19;fontColor=#18314e;fontFamily=Hiragino Sans,Noto Sans JP,Arial;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1720" y="950" width="440" height="130" as="geometry" />
        </mxCell>
        <mxCell id="ops" value="&lt;b&gt;公開のLean検証済み回答を確認&lt;/b&gt;&lt;br&gt;Web・API・DB・computeをAWSで稼働&lt;br&gt;既存Auroraデータ・roleを保持&lt;br&gt;復旧unit 3本を有効化／実再起動は未試験" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f3eefb;strokeColor=#aa95c4;strokeWidth=1.5;fontSize=18;fontColor=#18314e;fontFamily=Hiragino Sans,Noto Sans JP,Arial;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1720" y="1270" width="440" height="135" as="geometry" />
        </mxCell>
        <mxCell id="waf_notes" value="&lt;b&gt;WAFの実測　11:40 JST&lt;/b&gt;&lt;br&gt;ALB associationをAPIで読み戻し済み&lt;br&gt;default BLOCK / network source IP&lt;br&gt;ForwardedIP設定なし / sample保持なし&lt;br&gt;Cloudflare外からのALB直アクセスは403&lt;br&gt;TLS証明書検証成功&lt;br&gt;公式15範囲はCloudflare全体で共有。&lt;br&gt;個別zone認証の代用にはしない。&lt;br&gt;Host制限・アプリ認証は継続。" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf7ee;strokeColor=#579a72;strokeWidth=1.5;fontSize=18;fontColor=#18314e;fontFamily=Hiragino Sans,Noto Sans JP,Arial;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1720" y="1435" width="440" height="300" as="geometry" />
        </mxCell>
        <mxCell id="e_user" value="HTTPS 443" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#3a8760;strokeWidth=2;dashed=0;fontSize=16;fontFamily=Hiragino Sans,Noto Sans JP,Arial;fontColor=#3a8760;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="user" target="cloudflare">
          <mxGeometry relative="1" as="geometry" />
