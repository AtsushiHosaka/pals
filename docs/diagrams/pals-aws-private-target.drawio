        <mxCell id="user" value="&lt;b&gt;利用者&lt;/b&gt;&lt;br&gt;ブラウザー" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#edf3fa;strokeColor=#8ca4c0;strokeWidth=1.5;fontSize=19;fontColor=#18314e;fontFamily=Hiragino Sans,Noto Sans JP,Arial;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
