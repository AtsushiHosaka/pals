        <mxCell id="c-recipe" value="&lt;b&gt;Lean Recipe catalog&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#2F6FB0&quot;&gt;&lt;b&gt;● ベクトルなし&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#6B7785&quot;&gt;検証済みLeanソース&lt;br&gt;・形式文SHA-256の厳密一致&lt;br&gt;・英語全文検索（上位8件）&lt;br&gt;・全件取得し、worker内でn-gramスコア&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6FB0;strokeWidth=2.4;fontFamily=Hiragino Sans,Noto Sans JP,Arial;fontSize=17;fontColor=#202A36;align=left;verticalAlign=top;spacingLeft=14;spacingRight=12;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="640" y="990" width="232" height="250" as="geometry" />
        </mxCell>
        <mxCell id="c-draft" value="&lt;b&gt;Draft catalog&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#8C4FD0&quot;&gt;&lt;b&gt;● pgvector(384)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#6B7785&quot;&gt;自然文の証明方針 433行&lt;br&gt;OpenMath正規形を埋め込み、コサイン距離で上位8件&lt;br&gt;配線済み・本番での使用は未確認&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C4FD0;strokeWidth=2.4;fontFamily=Hiragino Sans,Noto Sans JP,Arial;fontSize=17;fontColor=#202A36;align=left;verticalAlign=top;spacingLeft=14;spacingRight=12;spacingTop=10;dashed=1;dashPattern=8 5;" vertex="1" parent="1">
          <mxGeometry x="888" y="990" width="232" height="250" as="geometry" />
        </mxCell>
        <mxCell id="c-typed" value="&lt;b&gt;Typed catalog&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#8C4FD0&quot;&gt;&lt;b&gt;● 配列(384次元)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#6B7785&quot;&gt;pgvectorではなく、APIがコサイン計算して上位8件&lt;br&gt;機能フラグ（既定OFF）&lt;br&gt;本番での使用は未確認&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C4FD0;strokeWidth=2.4;fontFamily=Hiragino Sans,Noto Sans JP,Arial;fontSize=17;fontColor=#202A36;align=left;verticalAlign=top;spacingLeft=14;spacingRight=12;spacingTop=10;dashed=1;dashPattern=8 5;" vertex="1" parent="1">
          <mxGeometry x="1136" y="990" width="232" height="250" as="geometry" />
        </mxCell>
        <mxCell id="c-mat" value="&lt;b&gt;Project資料&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#2A8C82&quot;&gt;&lt;b&gt;● ベクトルなし&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#6B7785&quot;&gt;原本とOCRテキスト（Tesseract）&lt;br&gt;PostgreSQL全文検索で出典を取得&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2A8C82;strokeWidth=2.4;fontFamily=Hiragino Sans,Noto Sans JP,Arial;fontSize=17;fontColor=#202A36;align=left;verticalAlign=top;spacingLeft=14;spacingRight=12;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="1384" y="990" width="232" height="250" as="geometry" />
        </mxCell>
