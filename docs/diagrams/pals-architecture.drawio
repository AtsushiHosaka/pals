  <diagram id="agent" name="エージェント処理フロー">
    <mxGraphModel dx="2440" dy="1540" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2440" pageHeight="1540" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="PALS アーキテクチャ ― エージェントの動き" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Hiragino Sans,Noto Sans JP,Arial;fontSize=34;fontColor=#202A36;align=left;verticalAlign=top;spacing=0;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="28" width="1400" height="50" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="1つの質問が、2種類のworkerとLean verifierをどう通るか。OpenAIマークは、その手順がOpenAI APIを呼ぶことを示します。" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Hiragino Sans,Noto Sans JP,Arial;fontSize=18;fontColor=#6B7785;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="2200" height="30" as="geometry" />
        </mxCell>
        <mxCell id="laneA" value="" style="rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#F7FAFE;strokeColor=#2F6FB0;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="2360" height="550" as="geometry" />
        </mxCell>
        <mxCell id="laneA-t" value="評価worker（assessment lane）　質問を受け、保存済みRecipeを再利用するか、新規にLean証明するかを判定" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Hiragino Sans,Noto Sans JP,Arial;fontSize=22;fontColor=#2F6FB0;align=left;verticalAlign=top;spacing=0;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="132" width="2080" height="34" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="&lt;b&gt;① 受付&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#6B7785&quot;&gt;assessmentキューから取得し、APIでclaim。添付・Project資料を読む&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#202A36;strokeWidth=2.4;fontFamily=Hiragino Sans,Noto Sans JP,Arial;fontSize=18;fontColor=#202A36;align=left;verticalAlign=top;spacingLeft=14;spacingRight=12;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="190" width="250" height="200" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="&lt;b&gt;② 完全一致の近道&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#6B7785&quot;&gt;固定入力と一致すれば、検索を省いて再利用へ&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#202A36;strokeWidth=2.4;fontFamily=Hiragino Sans,Noto Sans JP,Arial;fontSize=18;fontColor=#202A36;align=left;verticalAlign=top;spacingLeft=14;spacingRight=12;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="410" y="190" width="250" height="200" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="&lt;b&gt;③ ローカル検索&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#6B7785&quot;&gt;新規の通常質問のみ。Recipe全件（32件以内）をAPIから取得し、2〜4文字n-gramのTF-IDFで上位5件&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#2F6FB0&quot;&gt;&lt;b&gt;● Recipe catalog&lt;/b&gt;&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#202A36;strokeWidth=2.4;fontFamily=Hiragino Sans,Noto Sans JP,Arial;fontSize=18;fontColor=#202A36;align=left;verticalAlign=top;spacingLeft=14;spacingRight=12;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="740" y="190" width="250" height="200" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="&lt;b&gt;④ 独立2審査（並列）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#6B7785&quot;&gt;GPT-6 Luna（low）×2。同じRecipe・revision・前提を両者が選んだときだけ承認&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#202A36;strokeWidth=2.4;fontFamily=Hiragino Sans,Noto Sans JP,Arial;fontSize=18;fontColor=#202A36;align=left;verticalAlign=top;spacingLeft=14;spacingRight=12;spacingTop=10;" vertex="1" parent="1">
